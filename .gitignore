.claude/

# Packages go in release/. None of it belongs in git.
release/

# Installers and archives (GitHub rejects files over 100 MB; attach them to a release instead)
*.exe
*.msi
*.msix
*.appx
*.zip
*.7z
*.dmg
*.pkg
*.AppImage
*.deb
*.rpm
*.snap
*.nupkg

# Rust build output, kept outside the repository by CARGO_TARGET_DIR, but in case it lands here.
rust/target/
