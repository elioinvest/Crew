{
  "name": "crew",
  "version": "2.5.2",
  "description": "Crew: work with your crew of coding agents (Claude Code and Codex) — projects and sessions, a terminal with a real input box, and a tabbed browser",
  "repository": {
    "type": "git",
    "url": "https://github.com/elioinvest/Crew.git"
  },
  "homepage": "https://github.com/elioinvest/Crew",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64"
  },
  "author": "Elio淘金之路",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0"
  },
  "productName": "Crew",
  "build": {
    "appId": "com.claudeterminal.app",
    "productName": "Crew",
    "directories": {
      "output": "release/v2.5.2"
    },
    "files": [
      "build/icon.ico",
      "build/icon.png",
      "build/icon.svg",
      "main.js",
      "package.json",
      "preload.js",
      "renderer/**"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Crew",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  }
}
