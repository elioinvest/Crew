{
  "name": "crew",
  "version": "2.5.46",
  "description": "Crew: work with your crew of coding agents (Claude Code and Codex) — projects and sessions, a terminal with a real input box, and a tabbed browser",
  "repository": {
    "type": "git",
    "url": "https://github.com/elioinvest/Crew.git"
  },
  "homepage": "https://github.com/elioinvest/Crew",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64",
    "dist:zip": "electron-builder --win zip --x64 --arm64"
  },
  "author": "Elio淘金之路",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@highlightjs/cdn-assets": "^11.11.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "ssh2": "^1.17.0"
  },
  "productName": "Crew",
  "build": {
    "appId": "com.claudeterminal.app",
    "productName": "Crew",
    "directories": {
      "output": "release/v2.5.46"
    },
    "files": [
      "build/icon.ico",
      "build/icon.png",
      "build/icon.svg",
      "main.js",
      "package.json",
      "preload.js",
      "statusline.js",
      "ssh.js",
      "crew-ssh.js",
      "agents.js",
      "crew.js",
      "browser.js",
      "providers.js",
      "files.js",
      "codex-prompt.md",
      "renderer/**",
      "!node_modules/node-pty/prebuilds/darwin-*/**",
      "!node_modules/node-pty/**/*.pdb"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Crew",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "${productName} Setup ${version}.${ext}"
    }
  }
}
